{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SubtitleOverlay",
  "version": "0.1.0",
  "identifier": "com.translator.subtitleoverlay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "SubtitleOverlay Settings",
        "width": 760,
        "height": 620,
        "minWidth": 560,
        "minHeight": 460,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "alwaysOnTop": false,
        "center": true,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "SubtitleOverlay",
        "width": 920,
        "height": 260,
        "minWidth": 280,
        "minHeight": 88,
        "decorations": false,
        "transparent": true,
        "backgroundColor": "#00000000",
        "resizable": true,
        "alwaysOnTop": true,
        "center": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "targets": []
  }
}
